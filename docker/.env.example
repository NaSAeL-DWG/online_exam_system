# 将此文件复制为同目录下的 .env，并将以下密码替换为互不相同的随机值。
# 数据库和 Redis 密码使用字母数字，避免连接 URL 中的特殊字符转义问题。
POSTGRES_PASSWORD=change-this-to-a-random-alphanumeric-password
REDIS_PASSWORD=change-this-to-another-random-alphanumeric-password
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
ADMIN_LOGIN_NAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-admin-password
ADMIN_REAL_NAME=系统管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE_NUMBER=13800000000
# HTTP 本地体验使用 development/false；生产环境需部署 HTTPS 并改为 production/true。
ENVIRONMENT=development
COOKIE_SECURE=false
HTTP_PORT=8080
